# Copy to .env for local development. Never commit .env — it is gitignored.
#
# convsearch reads exactly ONE environment variable. Everything else is
# configured in your workspace's config.yaml, not here.

# Enables the opt-in Anthropic answering backend for `ask` and `plan`
# (`--backend anthropic`). Retrieval always stays local; only the passages
# retrieved for a question are sent, and only when you select that backend.
# Leave unset to keep convsearch fully offline.
ANTHROPIC_API_KEY=

# Everything below is configured in workspace/config.yaml, NOT here:
#
#   llm.ollama_host        the local Ollama endpoint (default http://127.0.0.1:11434)
#   llm.backend            auto | ollama | anthropic
#   llm.model              the local model, default gemma3:1b
#   embedding_model        default BAAI/bge-small-en-v1.5
#   retrieval.profile      balanced | exact | semantic
#
# Run `convsearch init PATH` to create a workspace with a commented config.yaml,
# and `convsearch doctor -w PATH` to check whether answering is currently able
# to run.
