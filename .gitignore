# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
dist/
build/
*.egg-info/
.coverage
.coverage.*
htmlcov/

# --- Secrets and local config ---
# .env holds ANTHROPIC_API_KEY. .env.example is committed instead.
.env
.env.*
!.env.example

# --- Workspaces and generated data ---
# Everything under data/ is generated except data/synthetic/, the committed
# fixture corpus that CI gates on.
data/evaluation-runs/
data/workspaces/
workspace/
tmp-evaluation-runs/
tmp-evaluation-runs-debug/

# --- pytest temp roots (never commit these) ---
# The default temp root is unusable on some Windows machines, so the suite is
# run with --basetemp; these are the roots it lands in.
.pytest_tmp/
.pyt_tmp*/
tmp-pytest/
tmp-pytest-cache/
pt/

# --- Scratch ---
tmp/

# --- Agent tooling (not part of the project) ---
.claude/

# --- e2e (Playwright) ---
node_modules/
tests-e2e/.tmp-workspace/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# --- Real-browser session for `npm run live` (contains your ChatGPT login) ---
.chrome-profile/

# --- Deploy ---
.vercel

# --- Chrome extension packaging artefacts ---
# A leaked .pem is an unrecoverable loss of extension identity.
*.pem
*.crx
extension.zip

# --- Native-messaging host: generated by scripts/install-native-host.*
# Only the .template files are committed. These contain absolute local paths.
scripts/native-host/host-config.json
scripts/native-host/com.convsearch.host.json
scripts/native-host/convsearch-host.bat
scripts/native-host/convsearch-host.sh

# --- OS / editor noise ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# --- Launch minimization: kept LOCAL, not published ---
# Design/internal docs live on disk but are not pushed.
docs/*
!docs/screenshots/
!docs/screenshots/**
# Base-dir markdown kept local (README.md and LICENSE stay published).
/QUICKSTART.md
/CHANGELOG.md
/CONTRIBUTING.md
/SECURITY.md
/STORE.md
/DEPLOY.md
/PASS_STATE.md
/docs-manifest.json
# Editor/tooling dotfiles (kept local; .env.example stays published).
/.editorconfig
/.gitattributes
/.vercelignore
# Synthetic evaluation corpus + its harness kept LOCAL (not shipped publicly).
data/synthetic/
/tests/test_evaluation_units.py
/tests/integration/
/scripts/build-synthetic-data.py
